# ============================================================
# 工厂管理系统 · 环境变量模板
# 用法：复制为 .env 后按需修改（.env 不入库，install.bat 自动复制）
# 首次安装用默认值即可；改密码前先改这里再 up
# ============================================================

# 数据库账号（compose 内网使用，不对外暴露端口）
DB_USER=fms
DB_PASSWORD=fms
DB_NAME=fms

# 对外 HTTP 端口（厂内浏览器访问 http://<本机IP>:<HTTP_PORT>）
# 80 被占用时可改 8080 等
HTTP_PORT=80
