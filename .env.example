# ============================================================
# 工厂管理系统 · 环境变量模板
# 用法：复制为 .env 后按需修改（.env 不入库，install.bat 自动复制）
# 首次安装用默认值即可；改密码前先改这里再 up
# ============================================================

# 数据库账号（compose 内网使用，不对外暴露端口）
DB_USER=fms
DB_PASSWORD=fms
DB_NAME=fms

# 对外 HTTP 端口（厂内浏览器访问 http://<本机IP>:<HTTP_PORT>）
# 80 被占用时可改 8080 等
HTTP_PORT=80

# 业务时区（日期/单号按本地业务日计算；厂内在华保持 Asia/Shanghai，勿随意改动）
TZ=Asia/Shanghai

# ============================================================
# AI 接入（OpenAI 兼容网关，缺 key 自动降级 mock 模式）
# 文本/查数/摘要走 DeepSeek；图片解析需另配视觉模型 key（如阿里云百炼 qwen3-vl-flash）
# 【重要】运行时可在「设置 · 主数据 → AI 服务」页直接填写/修改，保存立即生效、
# 无需重启；DB 中保存的值优先于本文件（本文件仅作初始默认与恢复基准）
# ============================================================
# DeepSeek key（https://platform.deepseek.com 获取）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_CHAT_MODEL=deepseek-chat
# 视觉模型（图片订单解析；未配置时图片入口走 mock，可配阿里云百炼等）
AI_VISION_BASE_URL=
AI_VISION_KEY=
AI_VISION_MODEL=qwen3-vl-flash
